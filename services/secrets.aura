// ==============================================================================
// AURA-GCP: Secret Manager REST API v1
// ==============================================================================

import { getState } from "./state";
import { auditRequest, logEvent, safeParseJson, defaultStr } from "./utils";

export fn registerSecretsRoutes(mux: Any): Unit => {
  // 1. Create Secret: POST /v1/projects/:project/secrets
  mux.post("/v1/projects/:project/secrets", fn(req: Any, res: Any) => {
    let s = getState();
    let project = http.pathValue(req, "project");
    let querySecretId = http.query(req, "secretId");
    let payload = safeParseJson(req.rawBody);
    let secretId = if (querySecretId != "") {
      querySecretId
    }else if (payload.secretId != ()) {
      `${payload.secretId}`
    }else {
      "secret"
    };
    let fullName = `projects/${project}/secrets/${secretId}`;
    auditRequest(req, "SecretManager", 200);

    let exists = s.secretManagerSecrets.filter(fn(sec: Any): Bool => sec.name == fullName);
    let secretRecord = if (exists.length > 0) {
      exists[0]
    }else {
      let sec = {
        name: fullName,
        secretId: secretId,
        project: project,
        replication: {automatic: {}},
        createdAt: "2026-09-28T12:00:00.000Z",
        versions: []
      };
      s.secretManagerSecrets.push(sec);
      logEvent("SECRETS", "info", `Created secret '${fullName}'`);
      sec
    };

    http.json(res, http.StatusOK, secretRecord);
  });

  // 2. List Secrets: GET /v1/projects/:project/secrets
  mux.get("/v1/projects/:project/secrets", fn(req: Any, res: Any) => {
    let s = getState();
    let project = http.pathValue(req, "project");
    auditRequest(req, "SecretManager", 200);

    let secs = s.secretManagerSecrets.filter(fn(sec: Any): Bool => sec.project == project);
    http.json(res, http.StatusOK, {secrets: secs});
  });

  // 3. Access Secret Version: GET /v1/projects/:project/secrets/:secret/versions/:versionAction
  mux.get("/v1/projects/:project/secrets/:secret/versions/:versionAction", fn(req: Any, res: Any) => {
    let s = getState();
    let project = http.pathValue(req, "project");
    let secretId = http.pathValue(req, "secret");
    let versionAction = http.pathValue(req, "versionAction");
    let versionId = versionAction.replace(":access", "");
    let fullName = `projects/${project}/secrets/${secretId}`;
    auditRequest(req, "SecretManager", 200);

    let matched = s.secretManagerSecrets.filter(fn(sec: Any): Bool => sec.name == fullName || sec.secretId == secretId);
    if (matched.length > 0) {
      let sec = matched[0];
      let vMatched = if (versionId == "latest") {
        if (sec.versions.length > 0) {
          [sec.versions[sec.versions.length - 1]]
        }else {
          []
        }
      }else {
        sec.versions.filter(fn(v: Any): Bool => v.versionId == versionId)
      };

      if (vMatched.length > 0) {
        let v = vMatched[0];
        http.json(res, http.StatusOK, {
          name: v.name,
          payload: {
            data: v.payload
          }
        });
      }else {
        http.json(res, http.StatusNotFound, {
          error: {code: 404, message: `Secret version not found: ${versionId}`}
        });
      }
    }else {
      http.json(res, http.StatusNotFound, {
        error: {code: 404, message: `Secret not found: ${fullName}`}
      });
    }
  });

  // 4. List Versions: GET /v1/projects/:project/secrets/:secret/versions
  mux.get("/v1/projects/:project/secrets/:secret/versions", fn(req: Any, res: Any) => {
    let s = getState();
    let project = http.pathValue(req, "project");
    let secretId = http.pathValue(req, "secret");
    let fullName = `projects/${project}/secrets/${secretId}`;
    auditRequest(req, "SecretManager", 200);

    let matched = s.secretManagerSecrets.filter(fn(sec: Any): Bool => sec.name == fullName || sec.secretId == secretId);
    if (matched.length > 0) {
      http.json(res, http.StatusOK, {versions: matched[0].versions});
    }else {
      http.json(res, http.StatusOK, {versions: []});
    }
  });

  // 5. Secret Actions (Add Version): POST /v1/projects/:project/secrets/:secretAction
  mux.post("/v1/projects/:project/secrets/:secretAction", fn(req: Any, res: Any) => {
    let s = getState();
    let project = http.pathValue(req, "project");
    let secretAction = http.pathValue(req, "secretAction");
    let secretId = secretAction.replace(":addVersion", "");
    let fullName = `projects/${project}/secrets/${secretId}`;
    let payload = safeParseJson(req.rawBody);
    auditRequest(req, "SecretManager", 200);

    let matched = s.secretManagerSecrets.filter(fn(sec: Any): Bool => sec.name == fullName || sec.secretId == secretId);
    if (matched.length > 0) {
      let sec = matched[0];
      let versionNum = sec.versions.length + 1;
      let vId = `${versionNum}`;
      let data = if (payload.payload != () && payload.payload.data != ()) {
        `${payload.payload.data}`
      }else {
        "bG9jYWwtc2VjcmV0LXZhbHVl"
      };

      let vRecord = {
        name: `${fullName}/versions/${vId}`,
        versionId: vId,
        state: "ENABLED",
        payload: data,
        createdAt: "2026-09-28T12:00:00.000Z"
      };

      sec.versions.push(vRecord);
      logEvent("SECRETS", "info", `Added version '${vId}' to secret '${fullName}'`);
      http.json(res, http.StatusOK, vRecord);
    }else {
      http.json(res, http.StatusNotFound, {
        error: {code: 404, message: `Secret not found: ${fullName}`}
      });
    }
  });

  // 6. Get Secret: GET /v1/projects/:project/secrets/:secret
  mux.get("/v1/projects/:project/secrets/:secret", fn(req: Any, res: Any) => {
    let s = getState();
    let project = http.pathValue(req, "project");
    let secretId = http.pathValue(req, "secret");
    let fullName = `projects/${project}/secrets/${secretId}`;
    auditRequest(req, "SecretManager", 200);

    let matched = s.secretManagerSecrets.filter(fn(sec: Any): Bool => sec.name == fullName || sec.secretId == secretId);
    if (matched.length > 0) {
      http.json(res, http.StatusOK, matched[0]);
    }else {
      http.json(res, http.StatusNotFound, {
        error: {code: 404, message: `Secret not found: ${fullName}`}
      });
    }
  });

  // 7. Delete Secret: DELETE /v1/projects/:project/secrets/:secret
  mux.delete("/v1/projects/:project/secrets/:secret", fn(req: Any, res: Any) => {
    let s = getState();
    let project = http.pathValue(req, "project");
    let secretId = http.pathValue(req, "secret");
    let fullName = `projects/${project}/secrets/${secretId}`;
    auditRequest(req, "SecretManager", 204);

    s.secretManagerSecrets = s.secretManagerSecrets.filter(fn(sec: Any): Bool => sec.name != fullName && sec.secretId != secretId);
    logEvent("SECRETS", "info", `Deleted secret '${fullName}'`);

    http.json(res, http.StatusOK, {});
  });
};
