export fn getState(): Any => {
  storeInstance
};

export fn incrementRequestsCount(): Unit => {
  storeInstance.totalRequestsCount = storeInstance.totalRequestsCount + 1;
};

export fn clearRequestAuditLog(): Unit => {
  storeInstance.requestAuditLog = [];
};

export fn resetState(): Unit => {
  storeInstance.gcsBuckets = [];
  storeInstance.gcsObjects = [];
  storeInstance.pubsubTopics = [];
  storeInstance.pubsubSubscriptions = [];
  storeInstance.firestoreDocs = [];
  storeInstance.secretManagerSecrets = [];
  storeInstance.cloudFunctions = [];
  storeInstance.kmsKeyRings = [];
  storeInstance.cloudLogs = [];
  storeInstance.requestAuditLog = [];
  storeInstance.liveLogs = [];
};
