  kmsKeyRings: List<Any>,
  cloudLogs: List<Any>,
  liveLogs: List<Any>,
  requestAuditLog: List<Any>,
  totalRequestsCount: Int,
  bootTimestamp: Int,
  nextIdCounter: Int
};

